        "\n",
        "def _refine_with_grabcut(image_rgb, initial_contour):\n",
        "    mask = np.zeros(image_rgb.shape[:2], np.uint8)\n",
        "    x, y, w, h = cv2.boundingRect(initial_contour)\n",
        "    pad = int(0.1 * max(w, h))\n",
        "    rect = (max(0, x - pad), max(0, y - pad),\n",
        "            min(image_rgb.shape[1] - x, w + 2 * pad), min(image_rgb.shape[0] - y, h + 2 * pad))\n",
        "\n",
        "    bgd_model = np.zeros((1, 65), np.float64)\n",
        "    fgd_model = np.zeros((1, 65), np.float64)\n",
        "    img_bgr = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2BGR)\n",
        "    try:\n",
        "        cv2.grabCut(img_bgr, mask, rect, bgd_model, fgd_model, 5, cv2.GC_INIT_WITH_RECT)\n",
        "    except cv2.error:\n",
        "        return initial_contour\n",
        "\n",
        "    refined_mask = np.where((mask == 2) | (mask == 0), 0, 1).astype(np.uint8)\n",
        "    contours, _ = cv2.findContours(refined_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
