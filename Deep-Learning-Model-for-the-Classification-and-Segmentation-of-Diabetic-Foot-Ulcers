        "def apply_segmentation_overlay(image_path, mask_path, alpha=0.5, overlay_color=(0, 255, 0), boundary_color=(0, 255, 0), boundary_thickness=2):\n",
        "    # Load original image and mask\n",
        "    img = cv2.imread(image_path)\n",
        "    mask = cv2.imread(mask_path, cv2.IMREAD_GRAYSCALE)\n",
        "\n",
        "    if img is None or mask is None:\n",
        "        return None\n",
        "\n",
        "    # Resize mask to match image dimensions (if necessary, though they should be same)\n",
        "    if img.shape[:2] != mask.shape[:2]:\n",
        "        mask = cv2.resize(mask, (img.shape[1], img.shape[0]), interpolation=cv2.INTER_NEAREST)\n",
        "\n",
        "    # Find contours for the boundary\n",
        "    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
        "\n",
        "    # Create a colored segment for the overlay\n",
        "    colored_segment = np.zeros_like(img, dtype=np.uint8)\n",
        "    colored_segment[mask > 0] = overlay_color # Use the specified overlay_color (BGR format)\n",
        "\n",
        "    # Overlay the colored segment onto the original image\n",
        "    overlay = cv2.addWeighted(img, 1 - alpha, colored_segment, alpha, 0)\n",
        "\n",
        "    # Draw boundary on the overlay\n",
        "    cv2.drawContours(overlay, contours, -1, boundary_color, boundary_thickness)\n",
        "\n",
        "    return img, mask, overlay\n",
        "\n",
        "\n",
        "def display_overlay_samples(img_paths, mask_paths, num_samples=3):\n",
        "    plt.figure(figsize=(18, num_samples * 4))\n",
