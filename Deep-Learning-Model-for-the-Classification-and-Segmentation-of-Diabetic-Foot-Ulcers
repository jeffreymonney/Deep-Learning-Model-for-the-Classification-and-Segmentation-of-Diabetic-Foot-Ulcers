        "        logs = logs or {}\n",
        "        gap = logs.get('accuracy', 0) - logs.get('val_accuracy', 0)\n",
        "        if gap > self.gap_threshold:\n",
        "            print(f'  Epoch {epoch+1}: train/val gap={gap:.3f} — overfitting signal.')\n",
        "print('Loss + monitor ready.')"
