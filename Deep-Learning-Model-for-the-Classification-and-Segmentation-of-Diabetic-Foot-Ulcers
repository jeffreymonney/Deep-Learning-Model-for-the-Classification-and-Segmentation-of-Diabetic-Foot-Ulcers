        "import numpy as np\n",
        "\n",
        "\n",
        "class MahalanobisOODDetector:\n",
        "    def __init__(self):\n",
        "        self.class_means = None\n",
        "        self.inv_covariance = None\n",
        "        self.threshold = None\n",
        "\n",
        "    def fit(self, embeddings, labels, num_classes, shrinkage=1e-3):\n",
        "        \"\"\"embeddings: (N, D) array — run cls_full_model over the TRAINING\n",
        "        set (see the Colab cell provided separately) and collect the\n",
        "        embedding output. labels: (N,) integer class labels.\n",
        "\n",
        "        shrinkage regularizes the covariance estimate. This is not\n",
        "        optional: D=1408 (EfficientNetB2's embedding size) can exceed\n",
        "        the number of examples in your smallest class, which makes the\n",
        "        raw covariance matrix singular and uninvertible without this.\n",
        "        \"\"\"\n",
        "        embeddings = np.asarray(embeddings, dtype=np.float64)\n",
        "        labels = np.asarray(labels)\n",
        "        D = embeddings.shape[1]\n",
        "\n",
        "        self.class_means = {}\n",
        "        centered_all = []\n",
        "        for c in range(num_classes):\n",
        "            class_embeds = embeddings[labels == c]\n",
        "            if len(class_embeds) == 0:\n",
        "                raise ValueError(f'No embeddings for class {c} — fit() needs the full training set, not a sample.')\n",
        "            mean = class_embeds.mean(axis=0)\n",
        "            self.class_means[c] = mean\n",
        "            centered_all.append(class_embeds - mean)\n",
        "\n",
        "        centered_all = np.concatenate(centered_all, axis=0)\n",
        "        cov = np.cov(centered_all, rowvar=False)\n",
        "        cov_reg = cov + shrinkage * np.eye(D)\n",
        "        self.inv_covariance = np.linalg.inv(cov_reg)\n",
        "        return self\n",
        "\n",
        "    def distance(self, embedding):\n",
        "        \"\"\"Minimum Mahalanobis distance to any of the three class means.\n",
        "        Small = resembles at least one of your trained classes (i.e.\n",
        "        looks like SOME kind of foot/wound photo). Large = resembles\n",
        "        none of them.\"\"\"\n",
        "        embedding = np.asarray(embedding, dtype=np.float64)\n",
        "        dists = []\n",
        "        for mean in self.class_means.values():\n",
        "            diff = embedding - mean\n",
        "            d = float(np.sqrt(diff @ self.inv_covariance @ diff.T))\n",
        "            dists.append(d)\n",
        "        return min(dists)\n",
        "\n",
        "    def calibrate_threshold(self, val_embeddings, percentile=99):\n",
        "        distances = [self.distance(e) for e in val_embeddings]\n",
        "        self.threshold = float(np.percentile(distances, percentile))\n",
        "        return self.threshold\n",
        "\n",
        "    def is_in_distribution(self, embedding):\n",
        "        if self.threshold is None:\n",
        "            raise RuntimeError('Call calibrate_threshold() (or load a detector that already has one) first.')\n",
        "        d = self.distance(embedding)\n",
        "        return d <= self.threshold, d\n",
        "\n",
        "    def save(self, path):\n",
        "        class_indices = np.array(list(self.class_means.keys()))\n",
        "        class_means = np.array(list(self.class_means.values()))\n",
        "        np.savez(path, class_indices=class_indices, class_means=class_means,\n",
        "                 inv_covariance=self.inv_covariance, threshold=self.threshold)\n",
        "\n",
        "    @classmethod\n",
        "    def load(cls, path):\n",
        "        data = np.load(path)\n",
        "        detector = cls()\n",
        "        detector.class_means = {\n",
        "            int(idx): mean for idx, mean in zip(data['class_indices'], data['class_means'])\n",
        "        }\n",
        "        detector.inv_covariance = data['inv_covariance']\n",
        "        detector.threshold = float(data['threshold'])\n",
        "        return detector"
