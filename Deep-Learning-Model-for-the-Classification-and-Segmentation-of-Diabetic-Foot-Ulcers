        "def apply_severity_colormap(heatmap_uint8):\n",
        "\n",
        "    return _SEVERITY_LUT[heatmap_uint8]\n",
        "\n",
        "\n",
        "def build_grad_model(inference_model, target_layer_name='block6a_expand_activation'):\n",
        "    target_layer = inference_model.get_layer(target_layer_name)\n",
        "    return keras.Model(inputs=inference_model.inputs, outputs=[target_layer.output, inference_model.output])\n",
        "\n",
        "\n",
        "def generate_gradcam(grad_model, img_uint8, class_idx, percentile_floor=40, min_alpha=0.15):\n",
        "\n",
        "    inp = tf.constant(img_uint8[np.newaxis, ...], dtype=tf.uint8)\n",
        "    with tf.GradientTape() as tape:\n",
