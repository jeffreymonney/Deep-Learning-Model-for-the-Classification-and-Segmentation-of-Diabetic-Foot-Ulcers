        "def build_classifier(dropout=0.3, l2=1e-4):\n",
        "    raw_input = keras.Input(shape=(CLS_SIZE, CLS_SIZE, 3), dtype=tf.uint8, name='cls_input_uint8')\n",
        "    x = make_preprocess_layer()(raw_input)\n",
        "    backbone = EfficientNetB2(include_top=False, weights='imagenet', input_tensor=x, pooling=None)\n",
        "    backbone.trainable = False\n",
        "\n",
        "    feature_map = backbone.output\n",
        "    embedding = layers.GlobalAveragePooling2D(name='feature_embedding')(feature_map)\n",
        "    x = layers.BatchNormalization(name='bn_head')(embedding)\n",
        "    x = layers.Dropout(dropout, name='drop1')(x)\n",
        "    x = layers.Dense(256, kernel_regularizer=keras.regularizers.L2(l2), name='fc_256')(x)\n",
        "    x = layers.Activation('relu')(x)\n",
        "    x = layers.BatchNormalization()(x)\n",
        "    x = layers.Dropout(dropout, name='drop2')(x)\n",
        "    logits = layers.Dense(NUM_CLASSES, name='logits')(x)\n",
        "    predictions = layers.Activation('softmax', dtype='float32', name='predictions')(logits)\n",
        "\n",
        "    full_model = keras.Model(raw_input, [predictions, embedding], name='EfficientNetB2_DFU')\n",
        "    inference_model = keras.Model(raw_input, predictions, name='EfficientNetB2_DFU_infer')\n",
        "    return full_model, inference_model, backbone\n",
