        "@tf.function(jit_compile=False)\n",
        "def make_boundary_weight_map(y_true, kernel_size=5):\n",
        "    kernel = tf.ones((kernel_size, kernel_size, 1))\n",
        "    dilated = tf.nn.dilation2d(y_true, kernel, strides=[1,1,1,1], padding='SAME', data_format='NHWC', dilations=[1,1,1,1]) - 1.0\n",
        "    eroded = -tf.nn.dilation2d(-y_true, kernel, strides=[1,1,1,1], padding='SAME', data_format='NHWC', dilations=[1,1,1,1]) + 1.0\n",
        "    return tf.clip_by_value(dilated - eroded, 0.0, 1.0)\n",
        "\n",
        "def dice_loss(y_true, y_pred, smooth=1.0):\n",
        "    yt = tf.cast(tf.reshape(y_true, [-1]), tf.float32); yp = tf.cast(tf.reshape(y_pred, [-1]), tf.float32)\n",
        "    inter = tf.reduce_sum(yt*yp)\n",
        "    return 1.0 - (2.0*inter+smooth)/(tf.reduce_sum(yt)+tf.reduce_sum(yp)+smooth)\n",
        "\n",
        "def boundary_aware_bce(y_true, y_pred, boundary_weight=3.0):\n",
        "    bce = keras.losses.binary_crossentropy(tf.cast(y_true,tf.float32), tf.cast(y_pred,tf.float32))\n",
        "    bce = tf.expand_dims(bce, -1)\n",
        "    weight_map = 1.0 + boundary_weight * make_boundary_weight_map(y_true)\n",
        "    return tf.reduce_mean(bce * weight_map)\n",
        "\n",
        "def boundary_aware_combined_loss(y_true, y_pred):\n",
        "    return 0.4*dice_loss(y_true,y_pred) + 0.6*boundary_aware_bce(y_true,y_pred)\n",
        "\n",
        "def dice_coeff(y_true, y_pred, threshold=0.5, smooth=1.0):\n",
        "    yt = tf.cast(tf.reshape(y_true,[-1]), tf.float32); yp = tf.cast(tf.reshape(y_pred,[-1])>threshold, tf.float32)\n",
        "    inter = tf.reduce_sum(yt*yp)\n",
        "    return (2.0*inter+smooth)/(tf.reduce_sum(yt)+tf.reduce_sum(yp)+smooth)\n",
        "\n",
        "def iou_metric(y_true, y_pred, threshold=0.5, smooth=1.0):\n",
        "    yt = tf.cast(tf.reshape(y_true,[-1]), tf.float32); yp = tf.cast(tf.reshape(y_pred,[-1])>threshold, tf.float32)\n",
        "    inter = tf.reduce_sum(yt*yp); union = tf.reduce_sum(yt)+tf.reduce_sum(yp)-inter\n",
        "    return (inter+smooth)/(union+smooth)\n",
        "\n",
        "def boundary_iou(y_true, y_pred, threshold=0.5):\n",
        "    yt = tf.cast(y_true > 0.5, tf.float32); yp = tf.cast(y_pred > threshold, tf.float32)\n",
        "    band = make_boundary_weight_map(yt)\n",
        "    yt_b, yp_b = yt*band, yp*band\n",
        "    inter = tf.reduce_sum(yt_b*yp_b); union = tf.reduce_sum(yt_b)+tf.reduce_sum(yp_b)-inter\n",
        "    return (inter+1.0)/(union+1.0)\n",
        "print('Boundary-aware loss and metrics ready.')\n",
        "\n",
        "\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "from tensorflow import keras\n",
        "\n",
        "\n",
        "CUSTOM_OBJECTS = {\n",
        "    'boundary_aware_combined_loss': boundary_aware_combined_loss,\n",
        "    'dice_coeff': dice_coeff,\n",
        "    'iou_metric': iou_metric,\n",
        "    'boundary_iou': boundary_iou,\n",
        "}\n",
        "\n",
        "def load_segmentation_model(checkpoint_path):\n",
        "    model = keras.models.load_model(checkpoint_path, custom_objects=CUSTOM_OBJECTS, compile=False)\n",
        "    print(f'Attention U-Net loaded from {checkpoint_path}.')\n",
        "    return model\n",
        "\n",
        "def clean_mask_for_display(binary_mask, min_component_area_frac=0.02, close_kernel=7, open_kernel=3):\n",
        "\n",
        "    mask = binary_mask.astype(np.uint8)\n",
        "\n",
        "    close_k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (close_kernel, close_kernel))\n",
        "    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, close_k)\n",
        "\n",
        "    open_k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (open_kernel, open_kernel))\n",
        "    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, open_k)\n",
        "\n",
        "    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)\n",
        "    if num_labels <= 1:\n",
        "        return mask  # nothing found, return as-is (all background)\n",
        "\n",
        "    areas = stats[1:, cv2.CC_STAT_AREA]  # skip label 0 (background)\n",
        "    if len(areas) == 0:\n",
        "        return mask\n",
        "    max_area = areas.max()\n",
        "    keep_labels = [i + 1 for i, a in enumerate(areas) if a >= max_area * min_component_area_frac]\n",
        "\n",
        "    cleaned = np.isin(labels, keep_labels).astype(np.uint8)\n",
        "    return cleaned\n",
        "\n",
        "\n",
        "def detect_foot_boundary(image_rgb, use_grabcut_refinement=True):\n",
        "\n",
        "    hsv = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2HSV)\n",
        "    ycrcb = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2YCrCb)\n",
        "\n",
        "    hsv_mask = cv2.inRange(hsv, np.array([0, 15, 40]), np.array([35, 200, 255]))\n",
        "    ycrcb_mask = cv2.inRange(ycrcb, np.array([0, 130, 75]), np.array([255, 185, 140]))\n",
        "\n",
        "\n",
        "    skin_mask = cv2.bitwise_or(hsv_mask, ycrcb_mask)\n",
        "\n",
        "    k_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (25, 25))\n",
        "    k_open = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))\n",
        "    skin_mask = cv2.morphologyEx(skin_mask, cv2.MORPH_CLOSE, k_close)\n",
        "    skin_mask = cv2.morphologyEx(skin_mask, cv2.MORPH_OPEN, k_open)\n",
        "\n",
        "    contours, _ = cv2.findContours(skin_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
        "    if not contours:\n",
        "        return None\n",
        "    largest = max(contours, key=cv2.contourArea)\n",
        "    if cv2.contourArea(largest) < 0.05 * image_rgb.shape[0] * image_rgb.shape[1]:\n",
        "        return None\n",
        "    if use_grabcut_refinement:\n",
